{
  "name": "vip-go-mu-plugins-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "E2E Tests for mu-plugins",
  "scripts": {
    "setup-env": "./bin/setup-env.sh",
    "destroy-env": "vip dev-env destroy --slug=e2e-test-site",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run setup-env",
    "test": "playwright test -c playwright.config.ts",
    "posttest": "npm run destroy-env"
  },
  "author": "Automattic",
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "^1.1.1",
    "@babel/plugin-syntax-decorators": "^7.27.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "asana-phrase": "^0.0.8",
    "eslint-plugin-playwright": "^2.4.0",
    "typescript": "^6.0.2"
  }
}
